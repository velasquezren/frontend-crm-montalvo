{
  "name": "montalvo-crm-frontend",
  "version": "0.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run sello:build && npm run check:tipos && npm run lint && ng build",
    "lint": "npm run check:skills && node --test tools/verificar-ui.spec.mjs && node tools/verificar-ui.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && npm run check:tests",
    "watch": "npm run sello:build && ng build --watch --configuration development",
    "test": "npm run sello:build && ng test",
    "sello:build": "node tools/generar-sello-build.mjs",
    "sync:tipos": "node tools/generar-db-enums.mjs",
    "check:tipos": "node tools/generar-db-enums.mjs --check",
    "check:tests": "tsc -p tsconfig.spec.json --noEmit",
    "check:skills": "node tools/verificar-skills.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.7",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@angular/service-worker": "^21.2.25",
    "@schedule-x/angular": "^4.1.0",
    "@schedule-x/calendar": "^4.9.1",
    "@schedule-x/current-time": "^4.9.1",
    "@schedule-x/events-service": "^4.9.1",
    "@schedule-x/theme-default": "^4.9.1",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.3",
    "temporal-polyfill": "0.3.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.27",
    "@angular/cli": "^21.2.27",
    "@angular/compiler-cli": "^21.2.25",
    "@tailwindcss/postcss": "^4.1.12",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
