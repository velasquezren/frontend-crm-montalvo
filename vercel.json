{
  "version": 2,
  "git": {
    "deploymentEnabled": {
      "codex/meta-interacciones-fase-2": false
    }
  },
  "outputDirectory": "dist/montalvo-crm-frontend/browser",
  "rewrites": [
    {
      "source": "/((?!.*\\.[\\w]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(manifest.webmanifest|ngsw.json|ngsw-worker.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*).(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
